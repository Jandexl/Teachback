# Main AI: Featherless (https://featherless.ai). Paste your key after the = sign.
FEATHERLESS_API_KEY=
# Optional: force one Featherless model (for example a GLM, Kimi or DeepSeek model id). Leave empty to pick automatically.
FEATHERLESS_MODEL=
# Optional: model for quizzes, grading and the report (accuracy first). Leave empty to pick automatically.
FEATHERLESS_QUALITY_MODEL=

# Optional: voice for Brave/Firefox (and backup AI): Gemini. Free key at https://aistudio.google.com. Paste it after the = sign.
GEMINI_API_KEY=
# Optional: force one Gemini model. Leave empty to pick automatically.
GEMINI_MODEL=

# Optional: let Gemini answer when every Featherless model fails (off by default: Featherless only).
GEMINI_TEXT_BACKUP=off

# Optional: who can open the app. Empty means only this computer (keeps your API credits safe).
# Set to 0.0.0.0 to open it from other devices on your Wi-Fi, for example your phone.
HOST=
# Optional: port number (default 3000).
PORT=
# Optional: only needed on a web host that cuts requests off after a fixed time. Set it a
# little below that limit, in seconds. Empty: no limit.
REQUEST_TIME_LIMIT_SECONDS=
